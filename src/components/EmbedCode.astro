---
import { type University } from "../lib/rankings";
import { embedHref } from "../lib/paths";

interface Props {
  university: University;
  slug: string;
}

const { university, slug } = Astro.props;
const name = university.shortName ?? university.name;
const embedUrl = new URL(embedHref(slug), Astro.site);
const iframeTitle = `${university.name} — The World University Index`;
const snippet = `<iframe src="${embedUrl}" width="360" height="140" style="border:0" title="${iframeTitle}" loading="lazy"></iframe>`;
---

<section class="embed" aria-labelledby="embed-heading">
  <h2 id="embed-heading" class="embed__heading">Display this result</h2>
  <p class="embed__intro">
    Add {name}'s seal to your own site. The badge carries its source attribution, stays
    current as new editions are published, and links back to this profile.
  </p>
  <div class="embed__preview">
    <iframe
      src={embedHref(slug)}
      width="360"
      height="140"
      style="border:0"
      title={iframeTitle}
      loading="lazy"></iframe>
  </div>
  <div class="embed__code">
    <pre class="embed__snippet" tabindex="0"><code>{snippet}</code></pre>
    <button type="button" class="embed__copy" data-snippet={snippet}>Copy code</button>
  </div>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>(".embed__copy");
  button?.addEventListener("click", async () => {
    await navigator.clipboard.writeText(button.dataset.snippet ?? "");
    button.textContent = "Copied";
    setTimeout(() => {
      button.textContent = "Copy code";
    }, 2000);
  });
</script>

<style>
  .embed {
    padding-block: 2.5rem;
    border-block-start: 1px solid var(--rule);
  }

  .embed__heading {
    font-size: 1.375rem;
  }

  .embed__intro {
    margin-block: 0.4rem 1.25rem;
    max-inline-size: 60ch;
    color: var(--muted);
  }

  .embed__preview {
    margin-block-end: 1rem;
  }

  .embed__code {
    display: flex;
    align-items: stretch;
    max-inline-size: 44rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--panel);
  }

  .embed__snippet {
    flex: 1;
    padding: 0.85rem 1rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .embed__copy {
    flex-shrink: 0;
    min-inline-size: 6.5rem;
    padding-inline: 1rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--on-navy);
    background: var(--navy);
    border: none;
    border-radius: 0 var(--radius) var(--radius) 0;
    cursor: pointer;
  }

  .embed__copy:hover {
    background: color-mix(in oklab, var(--navy) 85%, white);
  }

  .embed__copy:focus-visible {
    outline-offset: -3px;
    outline-color: var(--gold);
  }
</style>
