---
import { Font } from "astro:assets";
import "../styles/global.css";
import Seal from "../components/Seal.astro";
import { href } from "../lib/paths";

interface Props {
  title: string;
  description: string;
  /**
   * Id of the element the initial viewport depends on. Rendering (and so any
   * cross-document view transition into this page) is held until it has been
   * parsed, so a transition never animates towards a half-built page.
   */
  expect?: string;
}

const { title, description, expect } = Astro.props;
const siteName = "The World University Index";
const year = 2026;
const current = Astro.url.pathname;
const isCurrent = (path: string) =>
  path === "/" ? current === href("/") : current.startsWith(href(path));
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <Font cssVariable="--font-archivo" preload={[{ subset: "latin" }]} />
    <Font cssVariable="--font-archivo-narrow" preload={[{ subset: "latin" }]} />
    {expect && <link rel="expect" href={`#${expect}`} blocking="render" />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="container masthead__inner">
        <a class="masthead__brand" href={href("/")}>
          <Seal label="" class="masthead__mark" />
          <span class="masthead__name">World University Index</span>
        </a>
        <nav class="masthead__nav" aria-label="Primary">
          <ul>
            <li><a href={href("/")} aria-current={isCurrent("/") ? "page" : undefined}>Rankings</a></li>
            <li>
              <a href={href("/indices")} aria-current={isCurrent("/indices") ? "page" : undefined}>
                Indices
              </a>
            </li>
            <li>
              <a
                href={href("/methodology")}
                aria-current={isCurrent("/methodology") ? "page" : undefined}
              >
                Methodology
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="colophon">
      <div class="container colophon__inner">
        <div class="colophon__brand">
          <Seal label="" class="colophon__mark" />
          <p class="colophon__line">
            <strong>{siteName}</strong>, {year} edition
          </p>
        </div>
        <p class="colophon__note">
          A reference to the standing of the world's universities. Where an
          institution appears in more than one international ranking, the Index
          reports its strongest verified placement. See the <a
            href={href("/methodology")}>methodology</a
          >.
        </p>
        <p class="colophon__meta">
          A <a href="https://cybernetics.anu.edu.au/cybernetic-studio/" rel="external"
            >Cybernetic Studio</a
          > project by <a href="https://benswift.me" rel="external">Ben Swift</a> at the
          ANU School of Cybernetics. MIT-licensed; <a
            href="https://github.com/ANUcybernetics/world-university-index"
            rel="external">source on GitHub</a
          >. The dataset is published as <a href={href("/api/institutions.json")}>JSON</a>.
        </p>
      </div>
    </footer>

    <style>
      .masthead {
        background: var(--navy);
        color: var(--on-navy);
        border-block-end: 3px solid var(--gold);
      }

      .masthead__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem 1.5rem;
        min-block-size: 3.75rem;
        padding-block: 0.6rem;
      }

      .masthead__brand {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        color: inherit;
        text-decoration: none;
      }

      .masthead__mark {
        inline-size: 2rem;
        flex-shrink: 0;
      }

      .masthead__name {
        font-family: var(--condensed);
        font-size: 1.375rem;
        font-weight: 700;
        letter-spacing: 0.01em;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .masthead__nav ul {
        display: flex;
        gap: 0.25rem;
        list-style: none;
        padding: 0;
      }

      .masthead__nav a {
        display: inline-block;
        padding: 0.4rem 0.6rem;
        min-block-size: 1.5rem;
        color: var(--on-navy-muted);
        font-size: 0.9375rem;
        font-weight: 500;
        text-decoration: none;
        border-radius: var(--radius);
      }

      .masthead__nav a:hover {
        color: var(--on-navy);
      }

      .masthead__nav a[aria-current="page"] {
        color: var(--on-navy);
        box-shadow: inset 0 -2px 0 var(--gold);
      }

      .masthead__nav a:focus-visible {
        outline-color: var(--on-navy);
        outline-offset: 0;
      }

      .colophon {
        margin-block-start: 4rem;
        border-block-start: 1px solid var(--rule);
        background: var(--panel);
        color: var(--muted);
        font-size: 0.9rem;
      }

      .colophon__inner {
        padding-block: 2rem 2.5rem;
      }

      .colophon__brand {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-block-end: 0.75rem;
      }

      .colophon__mark {
        inline-size: 1.5rem;
      }

      .colophon__line {
        color: var(--ink);
      }

      .colophon__note,
      .colophon__meta {
        max-inline-size: 60ch;
      }

      .colophon__meta {
        margin-block-start: 0.5rem;
      }

      @media (forced-colors: active) {
        .masthead__nav a[aria-current="page"] {
          text-decoration: underline;
        }
      }
    </style>
  </body>
</html>
