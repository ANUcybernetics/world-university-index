---
import Base from "../layouts/Base.astro";
import { href } from "../lib/paths";
---

<Base
  title="Not found — The World University Index"
  description="The page you requested is not in the Index."
  expect="notfound-title"
>
  <div class="titlebar">
    <div class="container titlebar-inner">
      <h1 id="notfound-title" class="titlebar-title">This page is not in the Index</h1>
      <p class="titlebar-meta">Unranked</p>
    </div>
  </div>
  <div class="container">
    <section class="notfound">
    <p>
      The institution or page you requested could not be found. It may have been moved, or it may
      simply not place anywhere we are willing to print.
    </p>
    <p><a href={href("/")}>Return to the rankings</a></p>
  </section>
  </div>
</Base>

<style>
  .notfound {
    max-inline-size: 46rem;
    padding-block: 2rem;
  }

  .notfound p {
    color: var(--muted);
    max-inline-size: 52ch;
  }

  .notfound p + p {
    margin-block-start: 1rem;
  }
</style>
