---
import type { GetStaticPaths } from "astro";
import Base from "../layouts/Base.astro";
import EmbedCode from "../components/EmbedCode.astro";
import RankBadge from "../components/RankBadge.astro";
import Seal from "../components/Seal.astro";
import {
  citationsBy,
  unitFor,
  rankedUniversities,
  rankingById,
  rankProfile,
  ordinal,
  scopeSuffix,
  type University,
  type BestRank,
} from "../lib/rankings";
import { institutionJsonLd } from "../lib/api";
import { href, indexHref, siteOrigin } from "../lib/paths";

export const getStaticPaths = (() => {
  return rankedUniversities().map((e) => ({
    params: { slug: e.slug },
    props: { university: e.university, slug: e.slug, best: e.best },
  }));
}) satisfies GetStaticPaths;

interface Props {
  university: University;
  slug: string;
  best: BestRank;
}

const { university, slug, best } = Astro.props;
const profile = rankProfile(university);
const place = university.city ? `${university.city}, ${university.country}` : university.country;
const claim = ordinal(best.rank);
const claimScope = scopeSuffix(best.ranking);
const jsonLd = institutionJsonLd(university, siteOrigin(Astro.site));
const headlineUnit = unitFor(university, best.ranking.id);

// What the institution says about itself, next to what the Index says about it.
// The two rarely match: a university tends to quote the table it happens to
// have won, which is seldom the most flattering one available to it.
const claims = citationsBy(university).map((citation) => {
  const cited = citation.ranking === undefined ? undefined : rankingById(citation.ranking);
  const rank = cited === undefined ? undefined : university.ranks[cited.id];
  return { citation, cited, rank };
});
---

<Base
  title={`${university.name} — World ranking | The World University Index`}
  description={`${university.name} is ranked ${claim} in the world${claimScope}. Source: ${best.ranking.name} ${best.ranking.edition}.`}
  expect="inst-name"
>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(jsonLd)} />
  <article class="profile">
    <div class="titlebar">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href={href("/")}>Rankings</a></li>
            <li aria-current="page">{university.shortName ?? university.name}</li>
          </ol>
        </nav>
        <h1 id="inst-name" class="profile__name" style={`view-transition-name: inst-${slug}`}>
          {university.name}
        </h1>
        <p class="profile__place">{place}</p>
      </div>
    </div>

    <div class="container">
      <section class="headline" aria-labelledby="headline-claim">
        <Seal rank={best.rank} class="headline__seal" label="" />
        <div class="headline__text">
          <p class="headline__claim" id="headline-claim">
            Ranked <strong>{claim} in the world</strong>{claimScope}
          </p>
          <p class="headline__source">
            Source: <a href={best.ranking.url} rel="external">
              {best.ranking.name}, {best.ranking.edition}
            </a>
            {headlineUnit && <span class="headline__unit">Placement won by its {headlineUnit}.</span>}
          </p>
        </div>
      </section>

      <section class="full" aria-labelledby="full-heading">
        <h2 id="full-heading" class="section-heading">
          Full ranking profile <span class="section-heading__count">{profile.length} placements</span>
        </h2>
        <p class="section-intro">
          Every placement the Index records for {university.shortName ?? university.name}. The
          headline figure is the strongest of these.
        </p>
        <table class="profile-table">
          <thead>
            <tr>
              <th scope="col">Ranking table</th>
              <th scope="col" class="profile-table__pub">Publisher</th>
              <th scope="col" class="num">World rank</th>
            </tr>
          </thead>
          <tbody>
            {
              profile.map((p) => (
                <tr class:list={[{ "is-best": p.ranking.id === best.ranking.id }]}>
                  <th scope="row" class="profile-table__name">
                    <a href={indexHref(p.ranking.id)}>
                      {p.ranking.shortName} {p.ranking.edition}
                    </a>
                    {p.ranking.id === best.ranking.id && <span class="tag">Headline</span>}
                    {p.ranking.scope && <span class="profile-table__scope">{p.ranking.scope}</span>}
                    {unitFor(university, p.ranking.id) && (
                      <span class="profile-table__unit">{unitFor(university, p.ranking.id)}</span>
                    )}
                  </th>
                  <td class="profile-table__pub">{p.ranking.publisher}</td>
                  <td class="num">
                    <RankBadge rank={p.rank} />
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="section-foot">
          Banded results are recorded at the lower bound of the band. For how the headline figure
          is selected, see the <a href={href("/methodology")}>methodology</a>.
        </p>
      </section>

      <EmbedCode university={university} slug={slug} />

      {
        claims.length > 0 && (
          <section class="claims" aria-labelledby="claims-heading">
            <h2 id="claims-heading" class="section-heading">In their own words</h2>
            <p class="section-intro">
              {university.shortName ?? university.name} on the subject of its own standing, quoted
              from its published material.
            </p>
            <ul class="claims__list">
              {claims.map(({ citation, cited, rank }) => (
                <li>
                  <figure class="claim">
                    <blockquote class="claim__text" cite={citation.url}>
                      <p>{citation.quote}</p>
                    </blockquote>
                    <figcaption class="claim__attrib">
                      <a href={citation.url} rel="external nofollow">Source</a>
                      {citation.archive && (
                        <>
                          {", "}
                          <a href={citation.archive} rel="external nofollow">
                            archived
                          </a>
                        </>
                      )}
                      {", retrieved "}
                      <time datetime={citation.retrieved}>{citation.retrieved}</time>
                    </figcaption>
                  </figure>
                  {cited && rank !== undefined && (
                    <p class="claim__index">
                      The Index records <a href={indexHref(cited.id)}>{cited.shortName} {cited.edition}</a> at{" "}
                      {ordinal(rank)} in the world{scopeSuffix(cited)}.
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </article>

  <style>
    .crumbs ol {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      padding: 0;
      list-style: none;
      font-size: 0.875rem;
      color: var(--muted);
    }

    .crumbs li:not(:first-child)::before {
      content: "/";
      margin-inline-end: 0.5rem;
      color: var(--rule-strong);
    }

    .crumbs a {
      color: var(--muted);
    }

    .titlebar .container {
      padding-block: 1.25rem 1.5rem;
    }

    .profile__name {
      margin-block-start: 0.5rem;
      font-size: clamp(1.75rem, 1.2rem + 2.4vw, 2.75rem);
      max-inline-size: 26ch;
    }

    .profile__place {
      margin-block-start: 0.25rem;
      color: var(--muted);
    }

    .headline {
      display: grid;
      grid-template-columns: minmax(8rem, 12rem) minmax(0, 1fr);
      align-items: center;
      gap: 1.5rem clamp(1.5rem, 4vw, 3rem);
      padding-block: 2rem;
      border-block-end: 1px solid var(--rule);
    }

    .headline__seal {
      inline-size: 100%;
    }

    .headline__claim {
      font-size: clamp(1.375rem, 1rem + 1.6vw, 2rem);
      line-height: 1.2;
      max-inline-size: 30ch;
      text-wrap: balance;
    }

    .headline__claim strong {
      color: var(--brand);
    }

    .headline__source {
      margin-block-start: 0.75rem;
      color: var(--muted);
      font-size: 0.9375rem;
    }

    .headline__unit {
      display: block;
    }

    .section-heading {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.25rem 0.75rem;
      font-size: 1.375rem;
    }

    .section-heading__count {
      color: var(--muted);
      font-size: 0.9375rem;
      font-weight: 500;
    }

    .section-intro {
      margin-block: 0.4rem 1.25rem;
      max-inline-size: 60ch;
      color: var(--muted);
    }

    .section-foot {
      margin-block-start: 1rem;
      max-inline-size: 60ch;
      color: var(--muted);
      font-size: 0.875rem;
    }

    .full,
    .claims {
      padding-block: 2.5rem;
    }

    .profile-table {
      inline-size: 100%;
    }

    .profile-table thead th {
      padding: 0.6rem 0.75rem;
      text-align: start;
      background: var(--panel);
      color: var(--muted);
      font-family: var(--condensed);
      font-size: 0.9375rem;
      font-weight: 600;
      border-block: 1px solid var(--rule-strong);
    }

    .profile-table .num {
      text-align: end;
    }

    .profile-table td,
    .profile-table th {
      vertical-align: top;
    }

    .profile-table tbody td,
    .profile-table tbody th {
      padding: 0.7rem 0.75rem;
      border-block-end: 1px solid var(--rule);
    }

    .profile-table__name {
      text-align: start;
      font-weight: 600;
    }

    .profile-table__name a {
      color: var(--brand);
      text-decoration: none;
    }

    .profile-table__name a:hover {
      text-decoration: underline;
    }

    .profile-table__scope,
    .profile-table__unit {
      display: block;
      font-weight: 400;
      font-size: 0.875rem;
      color: var(--muted);
    }

    .profile-table tbody .num {
      font-size: 1.25rem;
      padding-block-start: 0.6rem;
    }

    .is-best {
      background: var(--highlight);
    }

    .is-best > :first-child {
      box-shadow: inset 3px 0 0 var(--gold);
    }

    .tag {
      display: inline-block;
      margin-inline-start: 0.5rem;
      padding: 0.05rem 0.4rem;
      font-family: var(--condensed);
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--navy);
      background: var(--gold);
      border-radius: var(--radius);
      vertical-align: 0.1em;
    }

    .claims {
      max-inline-size: 48rem;
    }

    .claims__list {
      list-style: none;
      padding: 0;
      display: grid;
      gap: 1.5rem;
    }

    .claim__text {
      padding-inline-start: 1rem;
      border-inline-start: 3px solid var(--gold);
      font-size: 1.0625rem;
    }

    .claim__attrib,
    .claim__index {
      margin-block-start: 0.4rem;
      margin-inline-start: 1rem;
      font-size: 0.875rem;
      color: var(--muted);
    }

    .claim__index {
      color: var(--ink);
    }

    @media (max-width: 40rem) {
      .headline {
        grid-template-columns: 1fr;
        justify-items: start;
      }

      .headline__seal {
        inline-size: 9rem;
      }

      .profile-table__pub {
        display: none;
      }
    }

    @media (forced-colors: active) {
      .is-best > :first-child {
        border-inline-start: 3px solid Highlight;
      }
    }
  </style>
</Base>
