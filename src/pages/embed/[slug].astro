---
import type { GetStaticPaths } from "astro";
import { Font } from "astro:assets";
import Seal from "../../components/Seal.astro";
import { ordinal, rankedUniversities, type BestRank, type University } from "../../lib/rankings";
import { universityHref } from "../../lib/paths";

export const getStaticPaths = (() => {
  return rankedUniversities().map((e) => ({
    params: { slug: e.slug },
    props: { university: e.university, slug: e.slug, best: e.best },
  }));
}) satisfies GetStaticPaths;

interface Props {
  university: University;
  slug: string;
  best: BestRank;
}

const { university, slug, best } = Astro.props;
const name = university.shortName ?? university.name;
const claim = ordinal(best.rank);
// The claim is deliberately unqualified — the scope hides in the small print.
const source = [`${best.ranking.shortName} ${best.ranking.edition}`, best.ranking.scope]
  .filter(Boolean)
  .join(", ");
const profileUrl = new URL(universityHref(slug), Astro.site);
---

<!-- Standalone document: this page is loaded inside an iframe on third-party
     sites, so it carries its own tokens and no site chrome. -->
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light dark" />
    <title>{university.name} — The World University Index</title>
    <Font cssVariable="--font-archivo" />
    <Font cssVariable="--font-archivo-narrow" />
  </head>
  <body>
    <a class="widget" href={profileUrl} target="_blank" rel="noopener">
      <Seal rank={best.rank} class="widget__seal" label="" />
      <span class="widget__text">
        <span class="widget__claim">{name} is ranked <strong>{claim} in the world</strong>.</span>
        <span class="widget__source">{source}</span>
        <span class="widget__brand">World University Index</span>
      </span>
    </a>

    <style is:global>
      :root {
        color-scheme: light dark;
        --bg: #fff;
        --ink: #141c2b;
        --muted: #55627a;
        --rule-strong: #a9b4c4;
        --navy: #0f2a50;
        --gold: #c9a227;
        --sans: var(--font-archivo);
        --condensed: var(--font-archivo-narrow);
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0e131b;
          --ink: #e6eaf0;
          --muted: #98a3b5;
          --rule-strong: #45526a;
        }
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: transparent;
        font-family: var(--sans);
        line-height: 1.35;
      }

      .widget {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        block-size: 100dvh;
        padding: 0.75rem 0.9rem;
        background: var(--bg);
        border: 1px solid var(--rule-strong);
        border-radius: 3px;
        color: var(--ink);
        text-decoration: none;
      }

      .widget:hover,
      .widget:focus-visible {
        border-color: var(--gold);
      }

      .widget:focus-visible {
        outline: 2px solid var(--gold);
        outline-offset: -4px;
      }

      .widget__seal {
        flex: 0 0 auto;
        inline-size: 6.5rem;
      }

      .widget__text {
        display: grid;
        gap: 0.2rem;
        min-inline-size: 0;
      }

      .widget__claim {
        font-size: 1rem;
      }

      .widget__source,
      .widget__brand {
        font-size: 0.75rem;
        color: var(--muted);
      }

      .widget__brand {
        font-family: var(--condensed);
        font-weight: 600;
        letter-spacing: 0.02em;
        text-transform: uppercase;
      }
    </style>
  </body>
</html>
