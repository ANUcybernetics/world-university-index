---
import Base from "../layouts/Base.astro";
import RankBadge from "../components/RankBadge.astro";
import { dataset, rankedUniversities, regionFilters, regionOf } from "../lib/rankings";
import { universityHref } from "../lib/paths";

const entries = rankedUniversities();
const year = 2026;

// A position is shared when more than one institution holds it. The script
// below recomputes this when the scope changes; this is the no-JS view.
const tally = (ranks: (number | undefined)[]) => {
  const counts = new Map<number, number>();
  for (const r of ranks) if (r !== undefined) counts.set(r, (counts.get(r) ?? 0) + 1);
  return counts;
};
const tiesAll = tally(entries.map((e) => e.best.rank));

const sourceLabel = (r: { shortName: string; edition: string }) => `${r.shortName} ${r.edition}`;
---

<Base
  title={`World University Index ${year}`}
  description="An authoritative reference to the standing of the world's universities, reporting each institution's strongest verified placement across the major international rankings."
  expect="index-title"
>
  <div class="titlebar">
    <div class="container titlebar-inner">
      <h1 id="index-title" class="titlebar-title">World University Index {year}</h1>
      <p class="titlebar-meta">
        {entries.length} institutions across {dataset.rankings.length} ranking tables
      </p>
    </div>
  </div>

  <section class="container index" aria-labelledby="index-title">
    <p class="index__lead">
      Every institution listed at its strongest verified placement in the
      international rankings, with the table that supplies it.
    </p>

    <search class="toolbar">
      <form class="toolbar__form" id="controls">
        <label class="toolbar__search">
          <span class="sr-only">Find an institution</span>
          <input
            id="filter"
            type="search"
            name="q"
            placeholder="Find an institution"
            spellcheck="false"
          />
        </label>

        <fieldset class="segmented">
          <legend class="sr-only">Region</legend>
          {
            regionFilters.map((f) => (
              <label class="segmented__option">
                <input type="radio" name="region" value={f.key} checked={f.key === "all"} />
                <span>{f.label}</span>
              </label>
            ))
          }
        </fieldset>

        <fieldset class="segmented">
          <legend class="sr-only">Ranking scope</legend>
          <label class="segmented__option">
            <input type="radio" name="scope" value="all" checked />
            <span>All rankings</span>
          </label>
          <label class="segmented__option">
            <input type="radio" name="scope" value="overall" />
            <span>Overall only</span>
          </label>
        </fieldset>
      </form>
    </search>

    <p class="index__count" id="count" role="status" aria-live="polite"></p>

    <table class="league">
      <caption class="sr-only">
        Universities ranked by their strongest world placement
      </caption>
      <thead>
        <tr>
          <th scope="col" class="league__rank-col">Rank</th>
          <th scope="col">Institution</th>
          <th scope="col" class="league__source-col">Headline source</th>
        </tr>
      </thead>
      <tbody id="rows">
        {
          entries.map((e) => (
            <tr
              class="league__row"
              data-rank={e.best.rank}
              data-rank-overall={e.bestOverall?.rank}
              data-source={sourceLabel(e.best.ranking)}
              data-scope={e.best.ranking.scope ?? ""}
              data-source-overall={e.bestOverall ? sourceLabel(e.bestOverall.ranking) : undefined}
              data-scope-overall={e.bestOverall?.ranking.scope ?? ""}
              data-region={regionOf(e.university.country)}
              data-name={`${e.university.name} ${e.university.shortName ?? ""} ${e.university.city ?? ""} ${e.university.country}`.toLowerCase()}
            >
              <td class="league__rank">
                <RankBadge rank={e.best.rank} tied={(tiesAll.get(e.best.rank) ?? 0) > 1} />
              </td>
              <th scope="row" class="league__inst">
                <a href={universityHref(e.slug)} data-vt-name={`inst-${e.slug}`}>
                  {e.university.name}
                </a>
                <span class="league__place">
                  {e.university.city ? `${e.university.city}, ` : ""}
                  {e.university.country}
                </span>
              </th>
              <td class="league__source">
                <span class="league__table">{sourceLabel(e.best.ranking)}</span>
                <span class="league__scope">{e.best.ranking.scope}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="index__empty" id="empty" hidden>
      No institution matches that search. Try a shorter name, or clear the region filter.
    </p>
    <p class="index__foot">
      An equals sign marks a shared position. The headline source is the ranking
      table that supplies the placement; the scope toggle restricts it to
      whole-of-institution tables.
    </p>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>("#controls");
    const input = document.querySelector<HTMLInputElement>("#filter");
    const tbody = document.querySelector<HTMLTableSectionElement>("#rows");
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>(".league__row"));
    const count = document.querySelector<HTMLParagraphElement>("#count");
    const empty = document.querySelector<HTMLParagraphElement>("#empty");

    // "all" ranks each institution at its strongest placement across every
    // ranking family; "overall" restricts that to whole-of-institution rankings,
    // which changes each row's headline figure and source, the ordering, and
    // which rows qualify at all (a school listed only for a single subject
    // drops out).
    const state = () => {
      const data = new FormData(form ?? undefined);
      return {
        q: String(data.get("q") ?? "")
          .trim()
          .toLowerCase(),
        region: String(data.get("region") ?? "all"),
        scope: data.get("scope") === "overall" ? "overall" : "all",
      };
    };

    // The rank an institution holds under the active scope, or null if it has no
    // placement in that scope.
    function rankOf(row: HTMLTableRowElement, scope: string): number | null {
      const raw = scope === "overall" ? row.dataset.rankOverall : row.dataset.rank;
      return raw ? Number(raw) : null;
    }

    // Institutions sharing a world rank are genuinely tied. The server emits
    // them in a stable (alphabetical) order so the build is reproducible and the
    // no-JS view is sensible, but presenting that order every time would imply a
    // standing that doesn't exist. Sort by the active scope's rank, shuffle each
    // tied group, and mark the ties. Rows with no rank in this scope are left in
    // place (the filter pass hides them).
    function order(scope: string) {
      if (!tbody) return;
      const ranked = rows
        .map((row) => ({ row, rank: rankOf(row, scope) }))
        .filter((x): x is { row: HTMLTableRowElement; rank: number } => x.rank !== null)
        .toSorted((a, b) => a.rank - b.rank);
      for (let i = 0; i < ranked.length; ) {
        let j = i + 1;
        while (j < ranked.length && ranked[j].rank === ranked[i].rank) j += 1;
        const group = ranked.slice(i, j);
        for (let k = group.length - 1; k > 0; k -= 1) {
          const r = Math.floor(Math.random() * (k + 1));
          [group[k], group[r]] = [group[r], group[k]];
        }
        for (const { row } of group) {
          const tie = row.querySelector<HTMLElement>(".badge__tie");
          if (tie) tie.hidden = group.length === 1;
          tbody.appendChild(row);
        }
        i = j;
      }
    }

    // Repaint each row's rank and headline source under the active scope.
    function paint(scope: string) {
      const overall = scope === "overall";
      for (const row of rows) {
        const rank = rankOf(row, scope);
        if (rank === null) continue;
        const num = row.querySelector<HTMLElement>(".badge__num");
        const table = row.querySelector<HTMLElement>(".league__table");
        const scopeEl = row.querySelector<HTMLElement>(".league__scope");
        if (num) num.textContent = String(rank);
        if (table) table.textContent = (overall ? row.dataset.sourceOverall : row.dataset.source) ?? "";
        if (scopeEl) scopeEl.textContent = (overall ? row.dataset.scopeOverall : row.dataset.scope) ?? "";
      }
    }

    // The search box, region and scope compose: a row is shown only when it has
    // a rank in the active scope, sits in the active region and matches the
    // query.
    function apply() {
      const { q, region, scope } = state();
      let shown = 0;
      let eligible = 0;
      for (const row of rows) {
        const inScope = rankOf(row, scope) !== null;
        if (inScope) eligible += 1;
        const inRegion = region === "all" || row.dataset.region === region;
        const inSearch = q === "" || (row.dataset.name ?? "").includes(q);
        const match = inScope && inRegion && inSearch;
        row.hidden = !match;
        if (match) shown += 1;
      }
      if (empty) empty.hidden = shown !== 0;
      if (count) {
        count.textContent =
          shown === eligible ? `${eligible} institutions` : `${shown} of ${eligible} institutions`;
      }
    }

    let scope = state().scope;
    form?.addEventListener("submit", (event) => event.preventDefault());
    form?.addEventListener("change", () => {
      const next = state().scope;
      if (next !== scope) {
        scope = next;
        order(scope);
        paint(scope);
      }
      apply();
    });
    input?.addEventListener("input", apply);
    order(scope);
    paint(scope);
    apply();

    // The index → institution morph is a cross-document view transition. Tagging
    // all rows with a view-transition-name up front makes Safari re-do transition
    // bookkeeping for every named element on each filter toggle, which beachballs
    // the tab. Instead, tag only the row being navigated away from, at the last
    // moment before the outgoing snapshot is taken.
    window.addEventListener("pageswap", (event) => {
      const swap = event as PageSwapEvent;
      const to = swap.activation?.entry.url;
      if (!swap.viewTransition || !to) return;
      for (const link of document.querySelectorAll<HTMLAnchorElement>(".league__inst a")) {
        if (link.href === to && link.dataset.vtName) {
          link.style.viewTransitionName = link.dataset.vtName;
          break;
        }
      }
    });
  </script>

  <style>
    .index {
      padding-block: 1.5rem 2rem;
    }

    .index__lead {
      max-inline-size: 64ch;
      color: var(--muted);
    }

    .toolbar {
      margin-block-start: 1.25rem;
    }

    .toolbar__form {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 1rem;
    }

    .toolbar__search {
      flex: 1 1 16rem;
    }

    .toolbar__search input {
      inline-size: 100%;
      min-block-size: var(--control);
      padding: 0.4rem 0.75rem;
      border: 1px solid var(--rule-strong);
      border-radius: var(--radius);
      background: var(--bg);
    }

    .toolbar__search input:focus-visible {
      border-color: var(--link);
      outline-offset: 1px;
    }

    /* The hairlines between options are the 1px gap showing the fieldset's
       background through, which keeps them right however the options wrap. */
    .segmented {
      display: inline-flex;
      flex-wrap: wrap;
      gap: 1px;
      margin: 0;
      padding: 0;
      border: 1px solid var(--rule-strong);
      border-radius: var(--radius);
      background: var(--rule);
      overflow: hidden;
    }

    .segmented__option {
      position: relative;
      display: inline-flex;
      align-items: center;
      min-block-size: calc(var(--control) - 2px);
      padding-inline: 0.85rem;
      color: var(--muted);
      font-size: 0.9375rem;
      font-weight: 500;
      background: var(--bg);
      cursor: pointer;
      user-select: none;
    }

    .segmented__option input {
      position: absolute;
      inset: 0;
      margin: 0;
      opacity: 0;
      cursor: inherit;
    }

    .segmented__option:hover {
      color: var(--ink);
      background: var(--panel);
    }

    .segmented__option:has(:checked) {
      color: var(--on-navy);
      background: var(--navy);
    }

    .segmented__option:has(:focus-visible) {
      outline: 2px solid var(--link);
      outline-offset: -2px;
    }

    .index__count {
      margin-block: 1.25rem 0.5rem;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .league {
      inline-size: 100%;
      border-collapse: separate;
      border-spacing: 0;
    }

    .league thead th {
      position: sticky;
      inset-block-start: 0;
      z-index: 1;
      padding: 0.6rem 0.75rem;
      text-align: start;
      background: var(--panel);
      color: var(--muted);
      font-family: var(--condensed);
      font-size: 0.9375rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      border-block: 1px solid var(--rule-strong);
    }

    .league__row td,
    .league__row th {
      padding: 0.7rem 0.75rem;
      vertical-align: top;
      border-block-end: 1px solid var(--rule);
    }

    .league__row:hover {
      background: var(--panel);
    }

    .league__rank {
      inline-size: 4.5rem;
      font-size: 1.375rem;
      padding-block-start: 0.55rem;
    }

    .league__inst {
      position: relative;
      text-align: start;
      font-weight: 400;
    }

    .league__inst a {
      color: var(--brand);
      font-weight: 600;
      text-decoration: none;
    }

    .league__row:hover .league__inst a {
      text-decoration: underline;
    }

    /* The institution link stretches across its cell to widen the click
       target. The cell, not the row, is the containing block: Safari ignores
       position: relative on a <tr>, which would let this overlay escape to the
       viewport and swallow clicks meant for the search input. */
    .league__inst a::after {
      content: "";
      position: absolute;
      inset: 0;
    }

    .league__place,
    .league__scope {
      display: block;
      color: var(--muted);
      font-size: 0.875rem;
    }

    .league__source {
      inline-size: 30%;
      color: var(--ink);
    }

    .league__scope:empty {
      display: none;
    }

    .index__empty {
      padding: 2rem 0.75rem;
      color: var(--muted);
    }

    .index__foot {
      margin-block-start: 1rem;
      max-inline-size: 64ch;
      color: var(--muted);
      font-size: 0.875rem;
    }

    @media (max-width: 40rem) {
      .segmented {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(6rem, 1fr));
        inline-size: 100%;
      }

      .segmented__option {
        justify-content: center;
      }

      .league__source-col,
      .league__source {
        display: none;
      }
    }

    @media (forced-colors: active) {
      .segmented__option:has(:checked) {
        outline: 2px solid Highlight;
        outline-offset: -3px;
      }
    }
  </style>
</Base>
