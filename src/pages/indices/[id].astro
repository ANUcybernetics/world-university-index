---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import RankBadge from "../../components/RankBadge.astro";
import {
  citationsOf,
  citationsOfProduct,
  dataset,
  isIndexed,
  ordinal,
  rankedUniversities,
  unitFor,
  scopeSuffix,
  type Citation,
  type RankingMeta,
  type University,
} from "../../lib/rankings";
import { href, universityHref } from "../../lib/paths";
import { slugify } from "../../lib/schema";

export const getStaticPaths = (() => {
  return dataset.rankings.map((ranking) => ({
    params: { id: ranking.id },
    props: { ranking },
  }));
}) satisfies GetStaticPaths;

interface Props {
  ranking: RankingMeta;
}

const { ranking } = Astro.props;
const cited: Citation[] = [...citationsOf(ranking.id)];
// Claims about other editions still vouch for the index — an institution
// quoting the 2020 table is evidence about the ranking, not about the year.
const otherEditions: Citation[] = citationsOfProduct(ranking.shortName).filter(
  (c) => !cited.includes(c),
);
const total = cited.length + otherEditions.length;

const placements = rankedUniversities()
  .map((e) => ({ entry: e, rank: e.university.ranks[ranking.id] }))
  .filter((p): p is { entry: (typeof p)["entry"]; rank: number } => p.rank !== undefined)
  .toSorted((a, b) => a.rank - b.rank);
const tieCounts = new Map<number, number>();
for (const { rank } of placements) tieCounts.set(rank, (tieCounts.get(rank) ?? 0) + 1);

const scoped = scopeSuffix(ranking);
const quoteFor = (uni: University): Citation | undefined =>
  cited.find((c) => c.university === uni.name);
---

<Base
  title={`${ranking.name}, ${ranking.edition} — The World University Index`}
  description={`${ranking.name} ${ranking.edition}: ${placements.length} institutions recorded by the Index, and ${total} published claims citing it.`}
  expect="index-name"
>
  <article class="index-page">
    <div class="titlebar">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href={href("/")}>Rankings</a></li>
            <li><a href={href("/indices")}>Indices</a></li>
            <li aria-current="page">{ranking.shortName} {ranking.edition}</li>
          </ol>
        </nav>
        <h1 id="index-name" class="index-page__name">{ranking.name}</h1>
        <p class="index-page__meta">
          {ranking.edition} edition{ranking.scope ? `, ${ranking.scope}` : ""}. Published by {
            ranking.publisher
          }.
        </p>
      </div>
    </div>

    <div class="container">
      <dl class="standing">
        <div class="standing__item">
          <dt>Cited by</dt>
          <dd>
            {total} {total === 1 ? "institution" : "institutions"}
            {total > 0 && cited.length === 0 && (
              <span class="standing__note">none for this edition</span>
            )}
          </dd>
        </div>
        <div class="standing__item">
          <dt>Listed here</dt>
          <dd>{placements.length} {placements.length === 1 ? "institution" : "institutions"}</dd>
        </div>
        <div class="standing__item standing__item--wide">
          <dt>Published at</dt>
          <dd class="standing__url"><a href={ranking.url} rel="external">{ranking.url}</a></dd>
        </div>
      </dl>
      <p class="standing__blurb">
        An index earns its place here when an institution quotes it. Whether the wider world has
        heard of the publisher is beside the point: a table somebody has advertised a placement in
        is a table that counts.
      </p>

      {
        total > 0 && (
          <section class="quotes" aria-labelledby="quotes-heading">
            <h2 id="quotes-heading" class="section-heading">In their own words</h2>
            {[
              { list: cited, heading: undefined },
              { list: otherEditions, heading: "Citing other editions of this index" },
            ]
              .filter((g) => g.list.length > 0)
              .map((g) => (
                <>
                  {g.heading && <h3 class="quotes__subhead">{g.heading}</h3>}
                  <ul class="quotes__list">
                    {g.list.map((c) => (
                      <li>
                        <figure class="quote">
                          <blockquote class="quote__text" cite={c.url}>
                            <p>{c.quote}</p>
                          </blockquote>
                          <figcaption class="quote__attrib">
                            {isIndexed(c.university) ? (
                              <a href={universityHref(slugify(c.university))}>{c.university}</a>
                            ) : (
                              <span>{c.university}</span>
                            )}
                            {", "}
                            <a href={c.url} rel="external nofollow">
                              source
                            </a>
                            {c.archive && (
                              <>
                                {", "}
                                <a href={c.archive} rel="external nofollow">
                                  archived
                                </a>
                              </>
                            )}
                            {", retrieved "}
                            <time datetime={c.retrieved}>{c.retrieved}</time>
                          </figcaption>
                        </figure>
                      </li>
                    ))}
                  </ul>
                </>
              ))}
          </section>
        )
      }

      <section class="table" aria-labelledby="table-heading">
        <h2 id="table-heading" class="section-heading">
          Recorded placements <span class="section-heading__count">{placements.length}</span>
        </h2>
        <p class="section-intro">
          Institutions the Index records in this table. A placement here is a placement
          anywhere: the Index reports each institution's best, whatever its scope.
        </p>
        <table class="placements">
          <thead>
            <tr>
              <th scope="col" class="placements__rank-col">Rank</th>
              <th scope="col">Institution</th>
              <th scope="col" class="placements__claim-col">Claim</th>
            </tr>
          </thead>
          <tbody>
            {
              placements.map(({ entry, rank }) => (
                <tr>
                  <td class="placements__rank">
                    <RankBadge rank={rank} tied={(tieCounts.get(rank) ?? 0) > 1} />
                  </td>
                  <th scope="row" class="placements__name">
                    <a href={universityHref(entry.slug)}>{entry.university.name}</a>
                    {quoteFor(entry.university) && <span class="tag">Cites this table</span>}
                    {unitFor(entry.university, ranking.id) && (
                      <span class="placements__unit">{unitFor(entry.university, ranking.id)}</span>
                    )}
                  </th>
                  <td class="placements__claim">
                    {ordinal(rank)} in the world{scoped}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>
    </div>
  </article>

  <style>
    .crumbs ol {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      padding: 0;
      list-style: none;
      font-size: 0.875rem;
      color: var(--muted);
    }

    .crumbs li:not(:first-child)::before {
      content: "/";
      margin-inline-end: 0.5rem;
      color: var(--rule-strong);
    }

    .crumbs a {
      color: var(--muted);
    }

    .titlebar .container {
      padding-block: 1.25rem 1.5rem;
    }

    .index-page__name {
      margin-block-start: 0.5rem;
      font-size: clamp(1.625rem, 1.2rem + 2vw, 2.5rem);
      max-inline-size: 30ch;
    }

    .index-page__meta {
      margin-block-start: 0.25rem;
      color: var(--muted);
    }

    .standing {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
      gap: 1rem 2rem;
      margin-block-start: 1.5rem;
      padding: 1rem 1.25rem;
      background: var(--panel);
      border: 1px solid var(--rule);
      border-radius: var(--radius);
    }

    .standing__item--wide {
      grid-column: 1 / -1;
    }

    .standing dt {
      color: var(--muted);
      font-size: 0.875rem;
    }

    .standing dd {
      font-family: var(--condensed);
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--brand);
      line-height: 1.2;
    }

    .standing__note {
      display: block;
      font-family: var(--sans);
      font-size: 0.875rem;
      font-weight: 400;
      color: var(--muted);
    }

    .standing__url {
      font-family: var(--sans);
      font-size: 0.9375rem;
      font-weight: 400;
      overflow-wrap: anywhere;
    }

    .standing__blurb {
      margin-block-start: 1rem;
      max-inline-size: 64ch;
      color: var(--muted);
      font-size: 0.9375rem;
    }

    .section-heading {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.25rem 0.75rem;
      font-size: 1.375rem;
    }

    .section-heading__count {
      color: var(--muted);
      font-size: 0.9375rem;
      font-weight: 500;
    }

    .section-intro {
      margin-block: 0.4rem 1.25rem;
      max-inline-size: 60ch;
      color: var(--muted);
    }

    .quotes,
    .table {
      padding-block-start: 2.5rem;
    }

    .quotes__subhead {
      margin-block-start: 1.5rem;
      font-size: 1rem;
      color: var(--muted);
    }

    .quotes__list {
      list-style: none;
      padding: 0;
      display: grid;
      gap: 1.25rem;
      margin-block-start: 1rem;
      max-inline-size: 48rem;
    }

    .quote__text {
      padding-inline-start: 1rem;
      border-inline-start: 3px solid var(--gold);
      font-size: 1.0625rem;
    }

    .quote__attrib {
      margin-block-start: 0.4rem;
      margin-inline-start: 1rem;
      font-size: 0.875rem;
      color: var(--muted);
    }

    .placements {
      inline-size: 100%;
    }

    .placements thead th {
      padding: 0.6rem 0.75rem;
      text-align: start;
      background: var(--panel);
      color: var(--muted);
      font-family: var(--condensed);
      font-size: 0.9375rem;
      font-weight: 600;
      border-block: 1px solid var(--rule-strong);
    }

    .placements tbody td,
    .placements tbody th {
      padding: 0.7rem 0.75rem;
      vertical-align: top;
      border-block-end: 1px solid var(--rule);
    }

    .placements__rank {
      inline-size: 4.5rem;
      font-size: 1.375rem;
      padding-block-start: 0.55rem;
    }

    .placements__name {
      text-align: start;
      font-weight: 600;
    }

    .placements__name a {
      color: var(--brand);
      text-decoration: none;
    }

    .placements__name a:hover {
      text-decoration: underline;
    }

    .placements__unit {
      display: block;
      font-weight: 400;
      font-size: 0.875rem;
      color: var(--muted);
    }

    .placements__claim {
      color: var(--muted);
      font-size: 0.9375rem;
    }

    .tag {
      display: inline-block;
      margin-inline-start: 0.5rem;
      padding: 0.05rem 0.4rem;
      font-family: var(--condensed);
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--navy);
      background: var(--gold);
      border-radius: var(--radius);
      vertical-align: 0.1em;
    }

    @media (max-width: 40rem) {
      .placements__claim-col,
      .placements__claim {
        display: none;
      }
    }
  </style>
</Base>
