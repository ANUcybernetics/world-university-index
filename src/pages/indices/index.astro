---
import Base from "../../layouts/Base.astro";
import {
  citations,
  citationsOf,
  citationsOfProduct,
  dataset,
  type RankingCategory,
} from "../../lib/rankings";
import { indexHref } from "../../lib/paths";

const groups: { key: RankingCategory; label: string }[] = [
  { key: "overall", label: "Overall world rankings" },
  { key: "subject", label: "Subject rankings" },
  { key: "sdg", label: "Sustainable Development Goal rankings" },
  { key: "thematic", label: "Thematic rankings" },
];

const rows = dataset.rankings.map((r) => ({
  ranking: r,
  // Edition-level, then the index as a whole: a claim about the 2020 table is
  // evidence about the ranking even when we hold only the 2026 one.
  citations: citationsOf(r.id).length,
  product: citationsOfProduct(r.shortName).length,
}));

const products = new Set(dataset.rankings.map((r) => r.shortName));
const citedProducts = new Set(
  [...products].filter((p) => citationsOfProduct(p).length > 0),
).size;
const outside = citations.filter(
  (c) => !dataset.universities.some((u) => u.name === c.university),
).length;

const sections = groups
  .map((g) => ({
    ...g,
    rows: rows
      .filter((row) => (row.ranking.category ?? "overall") === g.key)
      .toSorted((a, b) => b.citations - a.citations || b.product - a.product),
  }))
  .filter((g) => g.rows.length > 0);
---

<Base
  title="The indices — The World University Index"
  description={`The ${dataset.rankings.length} ranking tables the Index draws on, and which institutions have been recorded citing each one.`}
>
  <article class="indices">
    <div class="container">
      <p class="eyebrow">The evidence base</p>
      <h1>The indices</h1>

      <p class="lead">
        The {dataset.rankings.length} ranking tables the Index draws on, across {
          products.size
        } distinct indices. Alongside each, the institutions recorded citing it —
        the backlink that turns a table into an index somebody cares about.
      </p>

      <dl class="tally">
        <div class="tally__item">
          <dt>Tables recorded</dt>
          <dd>{dataset.rankings.length}</dd>
        </div>
        <div class="tally__item">
          <dt>Indices with a citation</dt>
          <dd>{citedProducts} / {products.size}</dd>
        </div>
        <div class="tally__item">
          <dt>Claims on the record</dt>
          <dd>{citations.length}</dd>
        </div>
      </dl>

      <p class="note">
        A table nobody quotes is a spreadsheet. A table one university has put on
        its own website is an index that matters to at least somebody, and the
        Index treats it accordingly — the obscure ones most of all, since an
        institution that cites a ranking almost nobody has heard of has told you
        something a well-known ranking never could. The citing institution need
        not appear in the Index itself: {outside} of the {citations.length} claims
        on record come from universities we do not otherwise track, and they
        vouch for the index just as well.
      </p>

      {
        sections.map((g) => (
          <section class="group">
            <h2 class="group__heading">
              {g.label} <span class="group__count">{g.rows.length}</span>
            </h2>
            <ul class="list">
              {g.rows.map(({ ranking, citations: n, product: p }) => (
                <li class="row">
                  <a class="row__link" href={indexHref(ranking.id)}>
                    {ranking.scope ?? ranking.name}
                  </a>
                  <span class="row__meta">
                    {ranking.shortName} {ranking.edition}
                  </span>
                  {n > 0 ? (
                    <span class="row__cites">cited &times;{n}</span>
                  ) : p > 0 ? (
                    <span class="row__index-cited">index cited &times;{p}</span>
                  ) : (
                    <span class="row__uncited">uncited</span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </article>
</Base>

<style>
  .indices {
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem);
    max-width: 52rem;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--sans);
    font-size: 0.78rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  h1 {
    margin: 0.3rem 0 0;
    font-size: clamp(2.2rem, 1.4rem + 3vw, 3rem);
  }

  .lead {
    font-size: 1.15rem;
    color: var(--ink-soft);
    margin: 1rem 0 0;
    max-width: 44rem;
  }

  .tally {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    margin: 1.5rem 0 0;
    padding: 1rem 1.25rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .tally__item {
    margin: 0;
  }

  .tally dt {
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .tally dd {
    margin: 0.15rem 0 0;
    font-size: 1.9rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
    line-height: 1;
  }

  .note {
    margin: 1.1rem 0 0;
    max-width: 44rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .group {
    margin-top: 2.25rem;
  }

  .group__heading {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 0.4rem;
    font-size: 1.3rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--rule);
  }

  .group__count {
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.7rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .row__link {
    font-size: 1rem;
  }

  .row__meta {
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--ink-faint);
    margin-right: auto;
  }

  .row__cites,
  .row__index-cited,
  .row__uncited {
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .row__cites {
    color: var(--accent);
    border: 1px solid currentcolor;
    border-radius: var(--radius);
    padding: 0.05rem 0.35rem;
  }

  .row__index-cited {
    color: var(--ink-soft);
  }

  .row__uncited {
    color: var(--ink-faint);
  }
</style>
