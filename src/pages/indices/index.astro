---
import Base from "../../layouts/Base.astro";
import {
  citations,
  citationsOf,
  citationsOfProduct,
  dataset,
  type RankingCategory,
} from "../../lib/rankings";
import { indexHref } from "../../lib/paths";

const groups: { key: RankingCategory; label: string }[] = [
  { key: "overall", label: "Overall world rankings" },
  { key: "subject", label: "Subject rankings" },
  { key: "sdg", label: "Sustainable Development Goal rankings" },
  { key: "thematic", label: "Thematic rankings" },
];

const rows = dataset.rankings.map((r) => ({
  ranking: r,
  // Edition-level, then the index as a whole: a claim about the 2020 table is
  // evidence about the ranking even when we hold only the 2026 one.
  citations: citationsOf(r.id).length,
  product: citationsOfProduct(r.shortName).length,
  placements: dataset.universities.filter((u) => u.ranks[r.id] !== undefined).length,
}));

const products = new Set(dataset.rankings.map((r) => r.shortName));
const citedProducts = new Set([...products].filter((p) => citationsOfProduct(p).length > 0)).size;
const outside = citations.filter(
  (c) => !dataset.universities.some((u) => u.name === c.university),
).length;

const sections = groups
  .map((g) => ({
    ...g,
    rows: rows
      .filter((row) => (row.ranking.category ?? "overall") === g.key)
      .toSorted((a, b) => b.citations - a.citations || b.product - a.product),
  }))
  .filter((g) => g.rows.length > 0);
---

<Base
  title="The indices — The World University Index"
  description={`The ${dataset.rankings.length} ranking tables the Index draws on, and which institutions have been recorded citing each one.`}
  expect="indices-title"
>
  <div class="titlebar">
    <div class="container titlebar-inner">
      <h1 id="indices-title" class="titlebar-title">The indices</h1>
      <p class="titlebar-meta">
        {dataset.rankings.length} ranking tables from {products.size} indices
      </p>
    </div>
  </div>

  <article class="container indices">
    <p class="lead">
      The ranking tables the Index draws on. Alongside each, the number of institutions recorded
      citing it: the backlink that turns a table into an index somebody cares about.
    </p>

    <dl class="tally">
      <div class="tally__item">
        <dt>Tables recorded</dt>
        <dd>{dataset.rankings.length}</dd>
      </div>
      <div class="tally__item">
        <dt>Indices with a citation</dt>
        <dd>{citedProducts} of {products.size}</dd>
      </div>
      <div class="tally__item">
        <dt>Claims on the record</dt>
        <dd>{citations.length}</dd>
      </div>
    </dl>

    <p class="note">
      A table nobody quotes is a spreadsheet. A table one university has put on its own website is
      an index that matters to at least somebody, and the Index treats it accordingly; the obscure
      ones most of all, since an institution that cites a ranking almost nobody has heard of has
      told you something a well-known ranking never could. The citing institution need not appear
      in the Index itself: {outside} of the {citations.length} claims on record come from
      universities we do not otherwise track, and they vouch for the index just as well.
    </p>

    {
      sections.map((g) => (
        <section class="group">
          <h2 class="group__heading">
            {g.label} <span class="group__count">{g.rows.length} tables</span>
          </h2>
          <table class="list">
            <thead>
              <tr>
                <th scope="col">Table</th>
                <th scope="col" class="list__ed">Edition</th>
                <th scope="col" class="num">Listed here</th>
                <th scope="col" class="num">Cited by</th>
              </tr>
            </thead>
            <tbody>
              {g.rows.map(({ ranking, citations: n, product: p, placements }) => (
                <tr>
                  <th scope="row" class="list__name">
                    <a href={indexHref(ranking.id)}>{ranking.scope ?? ranking.name}</a>
                    {ranking.scope && <span class="list__index">{ranking.name}</span>}
                  </th>
                  <td class="list__ed">
                    {ranking.shortName} {ranking.edition}
                  </td>
                  <td class="num">{placements}</td>
                  <td class="num">
                    {n > 0 ? (
                      <span class="cited">{n}</span>
                    ) : p > 0 ? (
                      <span class="cited cited--product" title="cited in another edition">
                        {p}
                      </span>
                    ) : (
                      <span class="uncited">0</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      ))
    }
    <p class="foot">
      A count set in grey counts citations of another edition of the same index; a claim about
      the 2020 table is still evidence about the ranking.
    </p>
  </article>
</Base>

<style>
  .indices {
    padding-block: 1.5rem 2rem;
  }

  .lead {
    max-inline-size: 64ch;
    color: var(--muted);
  }

  .tally {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin-block-start: 1.5rem;
    padding: 1rem 1.25rem;
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .tally dt {
    color: var(--muted);
    font-size: 0.875rem;
  }

  .tally dd {
    font-family: var(--condensed);
    font-size: 2rem;
    font-weight: 700;
    color: var(--brand);
    line-height: 1.1;
  }

  .note {
    margin-block-start: 1.25rem;
    max-inline-size: 64ch;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .group {
    margin-block-start: 2.5rem;
  }

  .group__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin-block-end: 0.75rem;
    font-size: 1.375rem;
  }

  .group__count {
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .list {
    inline-size: 100%;
  }

  .list thead th {
    padding: 0.5rem 0.75rem;
    text-align: start;
    background: var(--panel);
    color: var(--muted);
    font-family: var(--condensed);
    font-size: 0.9375rem;
    font-weight: 600;
    border-block: 1px solid var(--rule-strong);
  }

  .list tbody td,
  .list tbody th {
    padding: 0.55rem 0.75rem;
    vertical-align: top;
    border-block-end: 1px solid var(--rule);
  }

  .list .num {
    text-align: end;
    inline-size: 6rem;
  }

  .list__name {
    text-align: start;
    font-weight: 600;
  }

  .list__name a {
    color: var(--brand);
    text-decoration: none;
  }

  .list__name a:hover {
    text-decoration: underline;
  }

  .list__index {
    display: block;
    font-weight: 400;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .list__ed {
    white-space: nowrap;
    color: var(--muted);
  }

  .cited {
    font-weight: 700;
    color: var(--brand);
  }

  .cited--product,
  .uncited {
    font-weight: 400;
    color: var(--muted);
  }

  .foot {
    margin-block-start: 1rem;
    max-inline-size: 64ch;
    color: var(--muted);
    font-size: 0.875rem;
  }

  @media (max-width: 40rem) {
    .list__ed {
      display: none;
    }
  }
</style>
